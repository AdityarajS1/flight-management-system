# Copy this file to .env and replace every placeholder before running Compose.
DB_PASSWORD=replace-with-a-unique-database-password
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@flyhigh.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-grafana-password

# Optional integrations. Compose uses MailHog and demo payment by default.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=your-smtp-user
# MAIL_PASSWORD=your-smtp-password
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS_ENABLE=true
# GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# RAZORPAY_KEY_ID=your-razorpay-key-id
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret
